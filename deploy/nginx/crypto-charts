server {
    listen 443 ssl;
    server_name skyebeau.com;

    ssl_certificate /etc/letsencrypt/live/skyebeau.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/skyebeau.com/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    root /var/www;
    index index.html;

    location = /crypto-charts {
        return 301 /crypto-charts/;
    }

    location /crypto-charts/api/ {
        proxy_pass http://127.0.0.1:9000/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /crypto-charts/ {
        try_files $uri $uri/ /crypto-charts/index.html;
    }

    location / {
        try_files $uri $uri/ =404;
    }
}

server {
    listen 80;
    server_name skyebeau.com;
    return 301 https://$host$request_uri;
}
